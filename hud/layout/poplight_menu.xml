<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/poplight_menu.vcss_c" />
	</styles>

	<Panel class="poplight-screen" hittest="false">
		<Panel id="poplight_window"
               class="poplight-window"
               hittest="true">

			<Panel class="menu-header" hittest="false">
				<Label id="poplight_brand"
                       class="brand"
                       text="{s:text}" />
				<Label id="poplight_title"
                       class="menu-title"
                       text="{s:text}" />
				<Label id="poplight_description"
                       class="menu-description"
                       text="{s:text}" />
			</Panel>

			<Panel class="menu-content" hittest="false">

				<Button id="poplight_all" class="menu-row">
					<Label id="poplight_menu_number_0" class="row-number"
                           text="{s:text}" hittest="false" />
					<Panel class="row-copy" hittest="false">
						<Label id="poplight_all_text" class="row-title"
                               text="{s:text}" hittest="false" />
						<Label id="poplight_all_description" class="row-description"
                               text="{s:text}" hittest="false" />
					</Panel>
					<Label id="poplight_menu_arrow_0" class="row-arrow"
                           text="{s:text}" hittest="false" />
				</Button>

				<Label id="poplight_loadout_section" class="section-label"
                       text="{s:text}" hittest="false" />

				<Button id="poplight_knife" class="menu-row">
					<Label id="poplight_menu_number_1" class="row-number"
                           text="{s:text}" hittest="false" />
					<Panel class="row-copy" hittest="false">
						<Label id="poplight_knife_text" class="row-title"
                               text="{s:text}" hittest="false" />
						<Label id="poplight_knife_description" class="row-description"
                               text="{s:text}" hittest="false" />
					</Panel>
					<Label id="poplight_menu_arrow_1" class="row-arrow"
                           text="{s:text}" hittest="false" />
				</Button>

				<Button id="poplight_pistol" class="menu-row">
					<Label id="poplight_menu_number_2" class="row-number"
                           text="{s:text}" hittest="false" />
					<Panel class="row-copy" hittest="false">
						<Label id="poplight_pistol_name" class="row-title"
                               text="{s:text}" hittest="false" />
						<Label id="poplight_pistol_description" class="row-description"
                               text="{s:text}" hittest="false" />
					</Panel>
					<Label id="poplight_menu_arrow_2" class="row-arrow"
                           text="{s:text}" hittest="false" />
				</Button>

				<Button id="poplight_primary" class="menu-row">
					<Label id="poplight_menu_number_3" class="row-number"
                           text="{s:text}" hittest="false" />
					<Panel class="row-copy" hittest="false">
						<Label id="poplight_primary_name" class="row-title"
                               text="{s:text}" hittest="false" />
						<Label id="poplight_primary_description" class="row-description"
                               text="{s:text}" hittest="false" />
					</Panel>
					<Label id="poplight_menu_arrow_3" class="row-arrow"
                           text="{s:text}" hittest="false" />
				</Button>

				<Label id="poplight_appearance_section" class="section-label"
                       text="{s:text}" hittest="false" />

				<Button id="poplight_gloves" class="menu-row">
					<Label id="poplight_menu_number_4" class="row-number"
                           text="{s:text}" hittest="false" />
					<Panel class="row-copy" hittest="false">
						<Label id="poplight_gloves_text" class="row-title"
                               text="{s:text}" hittest="false" />
						<Label id="poplight_gloves_description" class="row-description"
                               text="{s:text}" hittest="false" />
					</Panel>
					<Label id="poplight_menu_arrow_4" class="row-arrow"
                           text="{s:text}" hittest="false" />
				</Button>

				<Button id="poplight_agents" class="menu-row">
					<Label id="poplight_menu_number_5" class="row-number"
                           text="{s:text}" hittest="false" />
					<Panel class="row-copy" hittest="false">
						<Label id="poplight_agents_text" class="row-title"
                               text="{s:text}" hittest="false" />
						<Label id="poplight_agents_description" class="row-description"
                               text="{s:text}" hittest="false" />
					</Panel>
					<Label id="poplight_menu_arrow_5" class="row-arrow"
                           text="{s:text}" hittest="false" />
				</Button>

			</Panel>

			<Panel class="menu-footer" hittest="false">
				<Label id="poplight_status" class="menu-status"
                       text="{s:text}" hittest="false" />

				<Button id="poplight_close" class="close-button">
					<Label id="poplight_close_text"
                           text="{s:text}" hittest="false" />
				</Button>
			</Panel>

		</Panel>
	</Panel>
</root>