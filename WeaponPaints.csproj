<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.378" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="ValveKeyValue" Version="0.73.0.538" />
    <PackageReference Include="ValvePak" Version="7.2.0.221" />
  </ItemGroup>

  <ItemGroup>
    <None Update="lang\**\*.*" CopyToOutputDirectory="PreserveNewest" />
	<None Update="data\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
	<Reference Include="CS2UIKit">
		<HintPath>3rd_party\CS2UIKit.dll</HintPath>
		<Private>true</Private>
	</Reference>
  </ItemGroup>
	<ItemGroup>
		<None Update="VERSION"
			  CopyToOutputDirectory="PreserveNewest"
			  CopyToPublishDirectory="PreserveNewest" />

		<None Update="LICENSE"
			  CopyToOutputDirectory="PreserveNewest"
			  CopyToPublishDirectory="PreserveNewest" />

		<None Update="3rd_party\CS2UIKit.LICENSE"
			  Link="CS2UIKit.LICENSE"
			  CopyToOutputDirectory="PreserveNewest"
			  CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>
</Project>
